# ==============================================================================
# FastAPI AI 추론 엔진 환경 설정 (.env.example)
# ==============================================================================
PORT=8000
HOST=0.0.0.0
APP_ENV=development

# CORS 허용 도메인 (콤마 구분)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# AI/NPU 모델 설정 (필요 시 활성화)
# MODEL_NAME=furiosa-ai-v1
# MODEL_PATH=./models/weights.pt

# DB·Gemini 설정은 BackEnd/.env.production (또는 선택한 .env.<mode>)에서 읽습니다.
# APP_ENV 기본은 production이며 local/development도 선택할 수 있습니다.
# 공통 파일에 DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME, DB_SSL을 준비합니다.
# Docker 호스트 PostgreSQL은 DB_HOST=host.docker.internal을 사용할 수 있습니다.
# WEATHER_PROJECT_DIR 생략 시 소스에 포함된 app/routers/weather_prediction을 사용합니다.

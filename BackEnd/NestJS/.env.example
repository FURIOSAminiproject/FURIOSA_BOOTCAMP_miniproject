# Copy to the selected .env.local/.env.development/.env.production and set real values.
# npm / PM2: NestJS/.env.<mode> < BackEnd/.env.<mode> < system environment.
# Compose reads the same two files in that order, then applies its environment overrides.
HOST=127.0.0.1
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=travel_local
DB_USER=
DB_PASSWORD=
DB_SSL=false
# TourAPI 수집 CLI 설정. 실제 키는 선택한 환경 파일 또는 시스템 환경에만 설정.
TOUR_API_KEY=
TOUR_API_MOBILE_APP=FuriosaTravel
TOUR_API_MAX_REQUESTS=200
TOUR_API_INTERVAL_MS=250
TOUR_API_TIMEOUT_MS=15000
# 서버 시작 시 자동 등록. 매일 01:00 Asia/Seoul에 수집.
TOUR_BATCH_LOOKBACK_DAYS=2
TOUR_BATCH_PAGE_SIZE=100
TOUR_BATCH_MAX_PAGES=10000
# 선택 필터: 비우면 전국의 지원 관광타입. 시군구 필터에는 시도가 필요.
TOUR_BATCH_REGION=
TOUR_BATCH_DISTRICT=
TOUR_BATCH_CONTENT_TYPE=
TOUR_BATCH_STATE_PATH=data/tour-batch/state.json
# ORS 요청별 DB 캐시 24시간 / ITS 영역별 DB 캐시 5분. 키는 서버 환경에만 보관.
ORS_API_KEY=
ORS_API_TIMEOUT_MS=15000
ITS_API_KEY=
ITS_API_TIMEOUT_MS=10000
ENABLE_TLS=false
# Required: generate and store a random secret of at least 32 characters.
JWT_SECRET=
FRONTEND_URL=http://localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/auth/google/callback
# Production: use the same HTTPS DNS hostname for FRONTEND_URL and GOOGLE_CALLBACK_URL.
# Register GOOGLE_CALLBACK_URL exactly in Google Console. Public IP callbacks are rejected.
# KAKAO_CLIENT_ID / KAKAO_CLIENT_SECRET (optional) / KAKAO_CALLBACK_URL
# NAVER_CLIENT_ID / NAVER_CLIENT_SECRET / NAVER_CALLBACK_URL

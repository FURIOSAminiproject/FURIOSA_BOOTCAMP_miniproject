{
  "name": "NestJS",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node scripts/start.cjs production",
    "start:dev": "node scripts/start.cjs development",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node scripts/start.cjs production",
    "lint": "oxlint --type-aware src/ test/",
    "test": "npm run build && npm run test:legacy && npm run test:unit",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "build:local": "node scripts/build.cjs local",
    "build:dev": "node scripts/build.cjs development",
    "build:op": "node scripts/build.cjs production",
    "build:prod": "node scripts/build.cjs production",
    "start:op": "node scripts/start.cjs production",
    "start::prod": "node scripts/start.cjs production",
    "start:local": "node scripts/start.cjs local",
    "start::local": "node scripts/start.cjs local",
    "db:check": "node scripts/check-db.cjs",
    "db:check:local": "node scripts/check-db.cjs local",
    "db:check:dev": "node scripts/check-db.cjs dev",
    "db:check:prod": "node scripts/check-db.cjs prod",
    "tour:ingest": "node scripts/tour-ingest.cjs",
    "test:legacy": "node --test test/*.test.cjs",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "db:check:postgis": "node scripts/check-postgis.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@google/genai": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/typeorm": "^12.0.2",
    "typeorm": "^1.1.2",
    "pg": "^8.23.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/observe": "^0.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2",
    "tsx": "^4.20.0",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}

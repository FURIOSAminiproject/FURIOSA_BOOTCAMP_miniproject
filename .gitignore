# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# 의존성 패키지 (Dependencies)
node_modules/

# 빌드 및 컴파일 산출물 (Build Outputs)
dist/
build/
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]

# 배포 백업 아카이브 (Deployment Backups)
backups/
*.tar.gz
*.tar
*.zip

# 환경 변수 및 보안 설정 파일 (All variants of .env & env.*)
# .env, .env.local, .env.development, env.production 등 모든 변형 포함
.env
.env*
.env.*
env.*
*.env
*.env.*

# 예시 템플릿 파일은 Git 추적 허용
!.env*.example
!env*.example

# 로그 파일 (Logs)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS 및 에디터 임시 메타데이터 (OS & Editor Metadata)
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
BackEnd/FastAPI/.env.example
